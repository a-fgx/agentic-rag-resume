GEMINI_API_KEY=your-gemini-api-key-here
CHAT_MODEL=gemini-2.0-flash

# ElevenLabs TTS — used when --voice flag is passed
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
# ELEVENLABS_VOICE_ID=your-cloned-voice-id   # leave blank to use default "Rachel" voice
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Phase 2 — MongoDB Atlas RAG
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=ragresume
MONGODB_COLLECTION=chunks
EMBEDDING_MODEL=text-embedding-004

# Alternative: use OpenAI instead of Gemini
# (remove GEMINI_API_KEY and set OPENAI_API_KEY instead)
# OPENAI_API_KEY=sk-...
# CHAT_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-large
